{
  "schemaVersion": 1,
  "id": "lumlib",
  "version": "${version}",
  "name": "LumLib",
  "description": "A lightweight, dependency-free configuration screen library for Fabric client mods.",
  "authors": [
    "Lumyrix"
  ],
  "contact": {
    "homepage": "https://github.com/lumyrix/LumLib",
    "sources": "https://github.com/lumyrix/LumLib",
    "issues": "https://github.com/lumyrix/LumLib/issues"
  },
  "license": "LICENSE",
  "icon": "assets/lumlib/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.lumyrix.lumlib.LumLibClientEntrypoint"
    ],
    "modmenu": [
      "dev.lumyrix.lumlib.modmenu.LumLibModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.17.0",
    "fabric-api": "*",
    "minecraft": "26.3",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
